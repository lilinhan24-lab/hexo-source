{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "audit": "npm audit --omit=dev --audit-level=critical",
    "build": "hexo generate --bail",
    "check": "npm run clean && npm run build && node tools/check-site.mjs && node tools/check-release.cjs",
    "check:site": "node tools/check-site.mjs",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "test": "node --test tests/*.test.cjs",
    "email:preview": "node tools/email-notifications.cjs dry-run",
    "email:templates": "node tools/email-preview.cjs",
    "email:test": "node tools/email-notifications.cjs test",
    "test:browser": "node tools/browser-smoke.mjs"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-butterfly": "^5.7.0",
    "hexo-wordcount": "^6.0.1",
    "image-size": "2.0.4",
    "sharp": "0.35.5",
    "katex": "0.19.0"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
